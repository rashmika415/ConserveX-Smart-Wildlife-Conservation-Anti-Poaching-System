{
  "name": "conservex",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "demo:collars": "node scripts/collar-demo.mjs",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:member1": "node scripts/test-member.mjs 1",
    "test:member2": "node scripts/test-member.mjs 2",
    "test:member3": "node scripts/test-member.mjs 3",
    "test:member4": "node scripts/test-member.mjs 4",
    "test:coverage": "npm run test:coverage --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed -w backend",
    "check": "npm run build && npm test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "vitest": "^4.1.11"
  }
}

PORT=4000
# Unacknowledged alerts are flagged after this many minutes (positive number).
ALERT_ESCALATION_MINUTES=15
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/wildlife_conservation
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
